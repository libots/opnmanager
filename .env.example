# Documentation only: export these into the process or load through your deployment tooling.
# Local scripts set local mode and disable debug automatically.
OPNMANAGER_LOCAL=1
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
# Optional: absolute writable data directory (same setting for setup and startup).
# OPNMANAGER_DATA_DIR=/var/lib/opnmanager
# OPNMANAGER_BIND=127.0.0.1:8000
# For an HTTPS deployment behind a trusted reverse proxy:
# OPNMANAGER_HTTPS=1
# DJANGO_TRUST_PROXY=1
# Production outside local mode requires a securely generated DJANGO_SECRET_KEY.
# DJANGO_SECRET_KEY=
OIDC_ENABLED=0
# OIDC_ISSUER=
# OIDC_RP_CLIENT_ID=
# OIDC_RP_CLIENT_SECRET=
# OIDC_OP_AUTHORIZATION_ENDPOINT=
# OIDC_OP_TOKEN_ENDPOINT=
# OIDC_OP_USER_ENDPOINT=
# OIDC_OP_JWKS_ENDPOINT=
# Per firewall, matching its credential_prefix:
# BRANCH1_API_KEY=
# BRANCH1_API_SECRET=

# Optional stable Fernet encryption key for UI-managed firewall credentials.
# Otherwise a private .credentials-key file is generated in OPNMANAGER_DATA_DIR.
# Back up that file together with your data (store separately from database-only backups).
# OPNMANAGER_CREDENTIAL_KEY=
